# Model APIs: OpenAI (analysis, purchase request, email), Anthropic (judge, email validator)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
# API access token, sent by clients in the X-API-Key header
API_ACCESS_TOKEN=your_secure_random_token_here

# LangSmith (LLMOps & Observability) - Optional
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=purchasing-automation

# App Settings
RATE_LIMIT_PER_DAY=5
